# ═══════════════════════════════════════════════════════════════
# AssetManager — .gitignore
# ═══════════════════════════════════════════════════════════════

# --- OS Generated ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/
.nox/
.ipynb_checkpoints/

# --- Node.js / Next.js ---
node_modules/
.next/
out/
.npm/
.eslintcache
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- C++ / Build ---
bin/
obj/
*.o
*.a
*.lib
*.dll
*.dylib
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# --- IDEs ---
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# --- Database & Cache ---
*.db
*.sqlite
*.sqlite3
*.duckdb
*.db-shm
*.db-wal
.rate_limit_cache/
.cache/

# --- Logs & Temp Files ---
*.log
*.tmp
*.bak
*.swp
*.swo
temp.json
temp_meta.json
test_config.json

# --- Large / Non-Essential Files ---
# PDFs, Office docs (keep repo lean)
*.pdf
*.docx
*.pptx
*.xlsx

# All markdown except README and workflow docs
**/*.md
!**/README.md
!.agent/workflows/*.md
!AGENTS.md

# --- External Repos (cloned separately) ---
external_repos/

# --- Knowledge Base (large PDFs + extracted text) ---
Finance_knowledge_base/

# --- Test OCR data ---
test_ocr/

# --- Data directory (local DuckDB + extracted KB) ---
data/

# --- Agent / Gemini internals ---
.gemini/
.agent/
!.agent/workflows/

# --- Project-specific ignores ---
backend/.env
frontend/.env*
!frontend/.env.example
cv_errors.log
cv_output.txt
