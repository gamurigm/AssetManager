# NVIDIA NIM
NVIDIA_NIM_API_KEY=your_key_here

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/asset_manager

# Auth
NEXTAUTH_SECRET=your_secret_here
JWT_SECRET=your_jwt_secret

# OpenBB
OPENBB_TOKEN=your_token_here

# Distributed runtime
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MARKET_DATA_SYMBOLS=AAPL,MSFT,TSLA,SPY,BTC/USD
MARKET_DATA_POLL_SECONDS=5
ANALYSIS_SYMBOLS=AAPL,MSFT,TSLA,SPY,BTC/USD
ANALYSIS_STRATEGY=ORB_FVG_ENGULFING
ANALYSIS_ACCOUNT_SIZE=10000
EXECUTION_GATEWAY_URL=http://127.0.0.1:8293

# The public API owns HTTP/Socket.IO, not broker sessions or scheduled trading.
API_ENABLE_KAFKA_FANOUT=true
API_ENABLE_SCHEDULER=false
API_ENABLE_BROKER_CONNECTIONS=false
