# MetaTrader 5 terminal connection (Windows, 64-bit)
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_CONNECT_TIMEOUT_MS=15000

# Safety: disabled | paper | live. Start with disabled, then paper.
MT5_EXECUTION_MODE=disabled
MT5_LIVE_TRADING_ENABLED=false
# Required in live mode. Use a short UTC epoch window; expired means fail-closed.
MT5_LIVE_ARMED_UNTIL_EPOCH=0
MT5_GATEWAY_TOKEN=replace-with-a-long-random-secret

# Explicit allowlists; empty means nothing may execute.
MT5_ALLOWED_EXPERTS=ema-cross-v1
MT5_ALLOWED_SYMBOLS=EURUSD

# Pre-trade risk limits.
MT5_MAX_VOLUME_PER_ORDER=0.10
MT5_MAX_MARGIN_PER_ORDER=500
MT5_MAX_EQUITY_DRAWDOWN_PCT=5
MT5_MAX_RISK_PER_ORDER_PCT=0.5
MT5_MAX_OPEN_POSITIONS=3
MT5_MAX_PENDING_ORDERS=3
MT5_MAX_TOTAL_VOLUME=0.30
MT5_MAX_SYMBOL_VOLUME=0.20
MT5_MAX_AGGREGATE_RISK_PCT=2.0
MT5_MAX_ORDERS_PER_MINUTE=3
MT5_MAX_ORDERS_PER_DAY=20
MT5_BLOCK_ON_UNPROTECTED_POSITION=true
MT5_REQUIRE_STOP_LOSS=true
MT5_MAX_SPREAD_POINTS=30
MT5_MAX_TICK_AGE_SECONDS=5
MT5_MAX_SIGNAL_AGE_SECONDS=10
MT5_DEFAULT_DEVIATION=10
MT5_FILLING_MODE=IOC
MT5_MAGIC=260806

# Execution-gateway supervision
MT5_RECONCILE_INTERVAL_SECONDS=30
MT5_RECONCILE_LIMIT=200
